# ─────────────────────────────────────────────
# Green and Fluffy Web — Environment Configuration
# Copy to .env and fill in values. PLACEHOLDERS ONLY in this file —
# never commit real secrets (public repository).
# ─────────────────────────────────────────────

# ── Application ──
NODE_ENV=development
PORT=3000

# ── API Connection ──
# Public URL: used in the browser. Relative = the page's own origin (nginx routes /api to the
# API), so it holds at the production hostname through the local proxy and anywhere else.
NEXT_PUBLIC_API_URL=/api/v1
# Internal URL: used for SSR and the dev /api rewrite. Host value here; compose sets the
# container-to-container address (http://api:3001/api/v1) for the web service.
API_INTERNAL_URL=http://localhost:3001/api/v1

# ── i18n ──
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,he,ru,uk

# Telegram login (NEXT_PUBLIC_TELEGRAM_BOT_ID) is introduced in Phase 1.
